{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Login Server",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\server\\SHO_LS.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\server",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:PATH};${workspaceFolder}\\bin\\release"
                }
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Launch World Server",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\server\\SHO_WS.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\server",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:PATH};${workspaceFolder}\\bin\\release"
                }
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Game Server",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\server\\SHO_GS.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\server",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:PATH};${workspaceFolder}\\bin\\release"
                }
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Client (Release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\bin\\release\\trose.exe",
            "args": ["@TRIGGER_SOFT@", "_server", "127.0.0.1"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\game",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:PATH};${workspaceFolder}\\bin\\release"
                }
            ],
            "console": "integratedTerminal"
